# ─── Turso (libSQL) — use libsql:// or libsqls:// from Turso dashboard ─────────
DATABASE_URL="libsql://YOUR_DB-YOUR_ORG.aws-region.turso.io"
TURSO_AUTH_TOKEN="your-prisma-database-token"

# Prisma Migrate does not accept libsql:// URLs (runtime adapter only).
# By default prisma.config.ts uses file:./dev.db for migrations when DATABASE_URL is Turso.
# Override if you want another local path:
# PRISMA_MIGRATE_DATABASE_URL="file:./prisma-local.db"

# After `pnpm prisma migrate dev`, apply new migration.sql files to Turso (uses DATABASE_URL + token).
# Skips folders already recorded in `_newsletter_ai_turso_migrations`. If Turso already had the first migration
# applied manually, the script will detect "already exists", mark it applied, and continue.
#   pnpm db:apply-turso
# To record a migration as applied without running SQL:
#   pnpm db:turso-mark-applied -- 20260430094410_init_newsletter_schema
#
# Turso CLI alternative:
#   turso db shell YOUR_DB_NAME < prisma/migrations/MIGRATION_FOLDER/migration.sql

# Optional: separate Turso DB for Mastra memory (defaults to DATABASE_URL when omitted + DATABASE_URL is libSQL)
# MASTRA_DATABASE_URL="libsql://YOUR_MEMORY_DB-YOUR_ORG.aws-region.turso.io"
# If that DB is different from DATABASE_URL, create a token for it (turso db tokens create YOUR_MEMORY_DB):
# MASTRA_TURSO_AUTH_TOKEN="your-mastra-database-token"

# ─── Publish (Resend) ───────────────────────────────────────────────────────────
# RESEND_API_KEY="re_..."
# RESEND_FROM="Newsletter <onboarding@resend.dev>"
# NEWSLETTER_PUBLISH_TO="you@example.com"

# ─── Clerk (Phase 1 auth) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# APP_URL="http://localhost:3000"

# ─── Local SQLite (omit Turso vars or use file URLs) ───────────────────────────
# DATABASE_URL="file:./dev.db"
